<?xml version="1.0"?>
<psalm
    errorLevel="7"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
	<issueHandlers>
		<PropertyNotSetInConstructor>
			<errorLevel type="suppress">
				<!-- This one is actually justified, as setting the protocol at
				     a later time is most likely a shoddy design compromise I
				     made to get a quick overview whether the whole 'Timeshare
				     instead of Forking' approach is reasonable. I have to
				     revisit it.-->
				<file name="src/include/Net/AsyncStream.php" /> 
				<!-- Critique on this one is justified, but SSLContext just
					serves as a factory. -->
				<file name="src/include/Net/SSLContext.php" /> 
				<file name="src/include/ValueObject/File.php" /> 
				<file name="src/include/Storage.php" />
				<file name="src/include/ORM/Node.php" /> 
				<file name="src/include/ORM/Partition.php" /> 
				<file name="src/include/ORM/Policy.php" /> 
				<file name="src/include/ORM/User.php" /> 
				<file name="src/include/ORM/VersionEntry.php" /> 
			</errorLevel>
		</PropertyNotSetInConstructor>
	</issueHandlers>
	<projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
			<directory name="prototyping" />
			<!-- This was a local only solution for first tests and is kept for
				 reference only. -->
			<directory name="src/include/Client/NodeLocal" />
			<!-- CommandHandler is a mess. Not a big mess, but a mess. The
				 problem is that there is no common ground whether the sub
				 handlers - update, query, delete, define - should return a
				 value or not, so it is a funny melange of return $something and
				 return; ie void. I tend towards every command having to return
				 something, but this needs to be designed consistently -->
			<directory name="src/include/CommandHandler" />
			<!-- deprecated -->
				<file name="src/include/Client/Node/RestoreListener.php" /> 
			<!-- deprecated -->
				<file name="src/include/Client/Node/Test.php" /> 
			<!-- StorageBasic is a mess which needs redesigning-->
			<file name="src/include/StorageBasic.php" />
			<file name="src/include/Storage/Disk.php" />
			<file name="src/include/Storage/BufferedWriter.php" />
			<file name="src/include/Storage/BufferedReader.php" />
			<file name="src/include/Storage/ExtentMain.php" />
			<!-- StreamHub is deprecated -->
			<file name="src/include/Net/StreamHub.php" />
			<file name="src/include/Net/StreamHubListener.php" />
        </ignoreFiles>
	</projectFiles>
</psalm>
